# ===== AIAPI.world 配置 =====
# 把你的 API Key 填在下面（不要带引号，不要留空）
AIAPI_API_KEY=sk-你的key
AIAPI_BASE_URL=https://aiapi.world/v1

# ===== 被测模型（5 个）的 model 字符串 =====
# 如果 aiapi.world 上型号名不同，在这里改即可，代码不用动
MODEL_DEEPSEEK=deepseek-v4
MODEL_QWEN=qwen3-max
MODEL_GLM=glm-5.3
MODEL_KIMI=kimi-k2
MODEL_GPT4O_MINI=gpt-4o-mini

# ===== 反向题改写模型（必须不在上面 5 个被测名单里）=====
REWRITE_MODEL=gemini-3-flash

# ===== 调用参数 =====
REPEAT=3
